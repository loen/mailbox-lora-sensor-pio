#pragma once

// ---------- Wi-Fi (2.4 GHz only) ----------
#define SECRET_WIFI_SSID "your_network"
#define SECRET_WIFI_PASS "your_password"

// ---------- MQTT (Mosquitto in Home Assistant) ----------
#define SECRET_MQTT_HOST "192.168.1.x"
#define SECRET_MQTT_USER "mqtt_user"
#define SECRET_MQTT_PASS "mqtt_password"
